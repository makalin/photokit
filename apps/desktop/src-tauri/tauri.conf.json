{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoKit",
  "version": "0.1.0",
  "identifier": "com.makalin.photokit",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Fast image tools & local AI studio",
    "longDescription": "Resize, convert, rename and batch-process photos, and edit them with local AI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
